# Server configuration
PORT=3001
NODE_ENV=development

# Optional PostgreSQL Connection (leave commented out to use local SQLite zero-config)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/grasshopper_db

# SQLite database path (used when DATABASE_URL is not set)
SQLITE_DB_PATH=./data/grasshopper.db

# CORS origin
CORS_ORIGIN=http://localhost:5173

